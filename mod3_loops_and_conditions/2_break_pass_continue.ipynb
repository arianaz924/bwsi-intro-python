# Q1: Print ingredients but stop at milk
ingredients = ["eggs", "flour", "vanilla extract", "sugar", "milk", "vegetable oil", "water"]

for item in ingredients:
    if item == "milk":
        print("We are out of milk!")
        break
    print(item)


# Q2: Loop through grades and print pass/fail, skip incomplete
grades = ["B", "incomplete", "A", "F", "C", "incomplete", "A", "F"]

for grade in grades:
    if grade == "incomplete":
        pass  # do nothing
    elif grade in ["A", "B", "C"]:
        print("pass")
    else:
        print("fail")


# Q3: Countdown from number to 1 but skip 7
number = 10
for i in range(number, 0, -1):
    if i == 7:
        continue
    print(i, end=" ")
print()  # newline at the end


# Q4: Stop infinite loop at 100 iterations
iterations = 0
while True:
    print(f'Number of times this loop has run: {iterations}')
    iterations += 1
    if iterations >= 100:
        break


# Q5: Stop the falling object once it hits the ground
height = 20
gravity = 9.8
while height > 0:
    print(f"Oh no! I'm falling and I'm {round(height,2)} ft from the ground!")
    height -= gravity
    if height < 0:  # ensure we don't go below ground
        height = 0
