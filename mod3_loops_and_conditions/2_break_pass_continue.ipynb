# Q1
ingredients = ["eggs", "flour", "vanilla extract", "sugar", "milk", "vegetable oil", "water"]

for item in ingredients:           # Loop through ingredients
    if item == "milk":             # Check if item is milk
        print("We are out of milk!")  # Print message
        break                      # Stop the loop
    print(item)                     # Print ingredient


# Q2
grades = ["B", "incomplete", "A", "F", "C", "incomplete", "A", "F"]

for grade in grades:               # Loop through grades
    if grade == "incomplete":      # Skip incomplete grades
        pass
    elif grade in ["A", "B", "C"]: # Pass grades
        print("pass")
    else:                          # Fail grades
        print("fail")


# Q3
number = 10

for i in range(number, 0, -1):    # Countdown from number to 1
    if i == 7:                     # Skip printing 7
        continue
    print(i, end=" ")
print()  # newline


# Q4
iterations = 0
while True:
    print(f'Number of times this loop has run: {iterations}')
    iterations += 1
    if iterations >= 100:          # Stop after 100 iterations
        break


# Q5
height = 20
gravity = 9.8
while height != 0:
    print("Oh no! I'm falling and I'm " + str(round(height,2)) + " ft from the ground!")
    height -= gravity              # Decrease height
    if height < 0:                 # Make sure it stops at 0
        height = 0
