# Q1 (FizzBuzz steps in words)
# A.1
# For each number from 1 to 100:
#   1. Check if the number is divisible by both 3 and 5
#       - If yes, print "FizzBuzz"
#   2. Else, check if the number is divisible by 3
#       - If yes, print "Fizz"
#   3. Else, check if the number is divisible by 5
#       - If yes, print "Buzz"
#   4. Else, print the number itself


# Q2 (FizzBuzz implementation)
for i in range(1, 101):                  # Loop from 1 to 100
    if i % 3 == 0 and i % 5 == 0:        # Check divisibility by both 3 and 5
        print("FizzBuzz")
    elif i % 3 == 0:                      # Check divisibility by 3
        print("Fizz")
    elif i % 5 == 0:                      # Check divisibility by 5
        print("Buzz")
    else:                                 # If none of the above, print the number
        print(i)


# Q3 (Prime numbers code descriptions filled in)
# Create list to store prime numbers
prime_numbers_list = []

# This for loop iterates over numbers from 2 to 10 inclusive
for n in range(2,11):
    # Set is_prime as True
    is_prime = True
    # This for loop iterates over all numbers from 2 to n-1
    for k in range(2, n):
        # This condition checks if n is divisible by k
        if n % k == 0:
            # If n % k == 0, then n is not a prime number (it has a divisor other than 1 and itself)
            print(f"{n} = {k} * {n // k}")
            is_prime = False
            break
    # This condition checks if is_prime is True
    if is_prime:
        # If n is prime, then print as output 
        # and append to list of prime numbers
        print(f"{n} is a prime number")
        prime_numbers_list.append(n)
        
print(f"\nList of prime numbers in range: {prime_numbers_list}")


