# Q1: Convert time to seconds using multiple return statements
def convert_time_to_sec(time, units):
    """Convert time from given units to seconds."""
    if units.lower() in ['min', 'minute', 'minutes']:  # Check if input is minutes
        return time * 60
    if units.lower() in ['hour', 'hours']:             # Check if input is hours
        return time * 3600
    return time                                        # Default case: assume input is already in seconds


# Test your function:
print(convert_time_to_sec(10, 'min'))       # Expected output: 600
print(convert_time_to_sec(2, 'hours'))      # Expected output: 7200
print(convert_time_to_sec(45, ''))          # Expected output: 45



# Q2: Recursive function to print numbers from 0 to 5
def my_recursive_function(number = 0):
    """Recursively print numbers from 0 to 5."""
    print(number)
    if number >= 5:           # Base case: stop recursion at 5
        return
    my_recursive_function(number + 1)  # Recursive call with incremented number


my_recursive_function()



# Q3: Recursive function to unpack nested list and print 'Bird'
nested_list = [[[['Bird']]]]

def unpack_list(nested_list):
    """Recursively unpack a nested list until a non-list element is reached, then print it."""
    if not isinstance(nested_list, list):  # Base case: if it's not a list, print the element
        print(nested_list)
        return
    # Recursive call on the first element of the list
    unpack_list(nested_list[0])


unpack_list(nested_list)
