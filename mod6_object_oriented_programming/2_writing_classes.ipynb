import random

class Cat:
    """Class representing a Cat."""

    def __init__(self, name, age, breed):
        """Initialize name, age, breed, and kitten status."""
        self.name = name
        self.age = age
        self.breed = breed
        self.is_kitten = age < 1  # True if age < 1 year

    def introduce(self):
        """Introduce the cat, adjusting message if it's a kitten."""
        if self.is_kitten:
            print(f"{self.name} is a {self.breed} kitten.")
        else:
            print(f"{self.name} is a {self.age} year old {self.breed}.")

    def meow(self):
        """Cat meows."""
        print("Meow!")

    def growl(self):
        """Cat growls."""
        print("Grrr...")

    def celebrate_birthday(self):
        """Celebrate the cat's birthday and update age."""
        if self.is_kitten:
            self.age = 1
            self.is_kitten = False
            print(f"It's {self.name}'s birthday! They are now 1 year old.")
        else:
            self.age += 1
            print(f"It's {self.name}'s birthday! They are now {self.age} years old.")

    def check_mood(self):
        """Check the cat's mood and react accordingly."""
        mood = random.choice(["happy", "grumpy", "sleepy"])
        if mood == "happy":
            self.meow()
        elif mood == "grumpy":
            self.growl()
        elif mood == "sleepy":
            print("Zzzz...")
