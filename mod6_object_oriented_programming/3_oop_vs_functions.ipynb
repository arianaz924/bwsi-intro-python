# ----------------------
# Q.3 OOP: Rectangle Class
# ----------------------
class Rectangle:
    """Class representing a rectangle."""
    
    def __init__(self, length, width):
        self.length = length
        self.width = width
    
    def area(self):
        return self.length * self.width
    
    def perimeter(self):
        return 2 * (self.length + self.width)

# Test with l=10, w=5
rect = Rectangle(10, 5)
print("OOP - Area:", rect.area())          # Area: 50
print("OOP - Perimeter:", rect.perimeter()) # Perimeter: 30

# ----------------------
# Q.4 FP: Functions for Rectangle
# ----------------------
def rectangle_area(length, width):
    return length * width

def rectangle_perimeter(length, width):
    return 2 * (length + width)

# Test with l=10, w=5
l, w = 10, 5
print("FP - Area:", rectangle_area(l, w))          # Area: 50
print("FP - Perimeter:", rectangle_perimeter(l, w)) # Perimeter: 30

# ----------------------
# Q.5 OOP with area and perimeter as attributes
# ----------------------
class Rectangle:
    """Class representing a rectangle with stored area and perimeter."""
    
    def __init__(self, length, width):
        self.length = length
        self.width = width
        # store computed values as attributes
        self.area = self.calculate_area()
        self.perimeter = self.calculate_perimeter()
    
    def calculate_area(self):
        return self.length * self.width
    
    def calculate_perimeter(self):
        return 2 * (self.length + self.width)

# Test with l=10, w=5
rect2 = Rectangle(10, 5)
print("OOP Attributes - Area:", rect2.area)          # Area: 50
print("OOP Attributes - Perimeter:", rect2.perimeter) # Perimeter: 30
